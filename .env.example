# ─────────────────────────────────────────────────────────────
# 새봄 환경변수 템플릿  (이 파일은 값 없이 git에 커밋됨 — 비밀 X)
#
# ▶ 로컬 개발: 이 파일을 복사해 `.env.local` 만들고 값 채우기
#     cp .env.example .env.local
# ▶ Vercel 배포: 아래 KEY들을 Vercel → Settings → Environment Variables 에
#     같은 이름으로 등록 (값은 .env.local 에 넣은 것과 동일하게)
# ─────────────────────────────────────────────────────────────

# ── LLM 선택: gemini | anthropic ──[필수]──
LLM_PROVIDER=gemini

# ── Gemini (LLM_PROVIDER=gemini 일 때 필요) ──
# 무료 키 발급: https://aistudio.google.com/app/apikey  (키는 AIza... 형식)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Anthropic (LLM_PROVIDER=anthropic 로 바꿀 때 필요) ──
# 발급: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Supabase (DB) ──[필수]──
# supabase.com → 프로젝트 → Settings → API
# 서버 전용(비밀): 절대 공개 금지
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 브라우저 노출용(공개 가능)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
